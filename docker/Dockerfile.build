# syntax=docker/dockerfile:1.7-labs

ARG BASE_IMAGE="debian:sid-slim"
# The ccache of the last good build (see the CI's Export ccache), or none
ARG CCACHE_IMAGE=scratch
FROM ${BASE_IMAGE} AS deps
LABEL maintainer="Maksym Sobolyev <sobomax@sippysoft.com>"

ARG BUILD_PKGS="cmake make clang lld libc6-dev openssl ccache"
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ${BUILD_PKGS}
WORKDIR /src

RUN --mount=type=bind,source=apt-get-requirement.txt,target=apt-get-requirement.txt \
   xargs -a apt-get-requirement.txt apt-get -yq --no-install-recommends install
RUN mkdir -p /ccache

# The ccache to start from: that image's, or an empty one
FROM ${CCACHE_IMAGE} AS ccache
COPY --from=deps /ccache/ /ccache/

FROM deps AS build
COPY --from=ccache /ccache /ccache
ARG CC=clang
# Use LLVM's linker for LTO, including platforms without LLVMgold.so.
ENV LDFLAGS="-fuse-ld=lld"
# Built through ccache, its cache for the platform's architecture alone,
# a cached object told the same by the compiler's version (rather than the
# size and time of its binary); the binaries kept in the image, as the
# source mounted goes with the RUN
RUN --mount=type=bind,target=.,rw \
  export CCACHE_DIR="/ccache/`dpkg --print-architecture`" \
    CCACHE_COMPILERCHECK="string:`${CC} --version | head -1`" \
    CMAKE_C_COMPILER_LAUNCHER=ccache && \
  find /ccache -mindepth 1 -maxdepth 1 ! -path "${CCACHE_DIR}" \
    -exec rm -rf {} + && \
  mkdir -p "${CCACHE_DIR}" && \
  ccache --max-size=100M && ccache --cleanup && ccache --zero-stats && \
  sh -x ./scripts/do-test-cmmn.sh && \
  sh -x ./scripts/do-test-cmake.sh && \
  ccache --show-stats && \
  mkdir -p /build && mv debug production /build/

# The packages of the libraries the binaries load (as ldd tells, and dpkg
# whose they are), for the test image to have them, and what they load in
# turn (sdl2-compat's SDL3, say), but none of the build's
FROM build AS test_pkgs
RUN for b in /build/debug/digger /build/production/digger; do ldd "${b}"; done | \
  awk '$2 == "=>" { print $1 }' | sort -u | \
  while read so; do dpkg -S "*/${so}" || echo "${so}: no package" >&2; done | \
  grep -v '^diversion ' | sed 's/[:,].*//' | sort -u > /test-pkgs.txt && \
  cat /test-pkgs.txt

# The tests as CI runs them, each platform in a container of its own on a
# runner of its own (see test_in_docker in .github/workflows/linux.yml),
# rather than all of them at once in the build, where they went short of
# CPU: the base image, with the build's binaries and the packages of the
# libraries they load, and the scripts and recordings the tests go by
FROM ${BASE_IMAGE} AS test_image
ARG DEBIAN_FRONTEND=noninteractive
COPY --from=test_pkgs /test-pkgs.txt /tmp/
RUN apt-get update && \
  xargs -a /tmp/test-pkgs.txt apt-get install -y --no-install-recommends && \
  rm -rf /var/lib/apt/lists/* /tmp/test-pkgs.txt
WORKDIR /src
COPY scripts scripts
COPY tests tests
COPY --from=build /build/debug debug
COPY --from=build /build/production production
# Every library the binaries load to be there, or the image is no good
RUN for b in debug/digger production/digger; do ldd "${b}"; done | \
  tee /dev/stderr | (! grep 'not found')
# The NetSim peers given longer to wait for each other, as an emulated
# platform needs (see do-test-netsim.sh)
ENV TEST_TYPES="quick netsim" DIGGER_NETSIM_SYNC_TIMEOUT=5000
CMD ["sh", "./scripts/do-test-run.sh"]

# The ccache alone, for the next build to start from (see CCACHE_IMAGE)
FROM scratch AS ccache_export
COPY --from=build /ccache /ccache
#FROM ${BASE_IMAGE} AS clean
#COPY --from=build /usr/local/lib/libg722.* /usr/local/lib/
#COPY --from=build --exclude=g722_common.h --exclude=g722_private.h \
# /usr/local/include/g722* /usr/local/include/
